# --- Zerodha Kite Connect (optional - only needed for live quotes, portfolio, orders) ---
# Get keys from https://developers.kite.trade
KITE_API_KEY=
KITE_API_SECRET=
# Optional: set directly if you already have a daily access token
# KITE_ACCESS_TOKEN=

# --- Tavily web research (optional - powers the research_symbol tool) ---
# Free tier at https://tavily.com
TAVILY_API_KEY=

# --- Paths (optional overrides) ---
# LLMFIN_TOKEN_FILE=~/.llmfin_session.json
# LLMFIN_DATA_DIR=~/.llmfin          # SQLite DBs + caches live here
# LLMFIN_RISK_FILE=risk_limits.json  # risk mandate, relative to cwd or absolute
